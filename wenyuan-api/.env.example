# Application
APP_NAME=文渊问史 API
APP_ENV=development
SECRET_KEY=change-this-in-local-env
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# 默认不配置 DATABASE_URL 时使用 SQLite: sqlite:///./wenyuan.db
# MySQL 示例:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/wenyuan?charset=utf8mb4
DATABASE_URL=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI-compatible LLM, 阶段 1 仅预留配置，阶段 2 接入问答服务
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
